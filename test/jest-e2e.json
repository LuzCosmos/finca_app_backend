{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/e2e"],
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "maxWorkers": 1,
  "testTimeout": 120000,
  "forceExit": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/jest-e2e.setup.ts"]
}
