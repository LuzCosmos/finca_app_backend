# Cómo usar: copia este archivo a test/.env.e2e (está en .gitignore) y ajusta valores.
# Requisitos: Postgres con migraciones aplicadas, Redis accesible.
# Si `.env` apunta a un host Docker (ej. develop_finca_app_postgres), sobrescribe aquí con localhost o el host que resuelva en tu máquina.

FA_DB_HOST=localhost
FA_DB_PORT=5432
FA_DB_USER=finca
FA_DB_PASSWORD=finca
FA_DB_NAME=finca_e2e
DB_SCHEMA=public

# ChirpStack — definir UNA sola vez CHIRPSTACK_API_KEY (JWT desde ChirpStack → API keys).
CHIRPSTACK_API_URL=http://192.168.1.2:28090
CHIRPSTACK_API_KEY=

# Opcional: E2E import LW001 con alta real en ChirpStack (UUIDs de tu instancia).
# E2E_CHIRPSTACK_DEVICE_PROFILE_ID=
# E2E_CHIRPSTACK_APPLICATION_ID=
# Desactivar tests que llaman ChirpStack: E2E_LW001_IMPORT_CHIRPSTACK=0

FA_REDIS_HOST=localhost
FA_REDIS_PORT=6379
# FA_REDIS_PASSWORD=

JWT_SECRET=change-me-e2e-only
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Login E2E + semilla (`npm run seed:e2e` crea tenant SYS_ADMIN, perfiles LW001 E2E, compra/recepción E2E y sincroniza contraseña).
# Perfiles sembrados (import manual / E2E): "E2E LW001 Default", "E2E LW001 Perfil B" (appKey hex con letra e).
# Recepción sembrada: proveedor "E2E Reception Provider", compra OPEN, lote E2E01, reses E2E-REC-001 (en lote), E2E-REC-002 (sin lote), E2E-REC-003 (arete duplicado).
# Si faltan las tres obligatorias, Jest omitirá los bloques autenticados (describe.skip).
# E2E_USERNAME=
# E2E_PASSWORD=
# E2E_COMPANY_USERNAME=

# Opcionales para seed:e2e (nombre del tenant, email admin, nombres).
# E2E_TENANT_NAME=E2E Local
# E2E_ADMIN_EMAIL=e2e-admin@example.invalid
# E2E_ADMIN_FIRST_NAME=E2E
# E2E_ADMIN_LAST_NAME=Admin

# Usuario MANAGER (sin FARM) para E2E 403 — `npm run seed:e2e` lo crea/actualiza si están definidos.
# E2E_LIMITED_USERNAME=e2e_limited
# E2E_LIMITED_PASSWORD=
# E2E_LIMITED_EMAIL=e2e-limited@example.invalid

# En CI (job con DB + Redis + usuario sembrado): fuerza fallo si faltan credenciales.
# E2E_REQUIRE_AUTH=true
