# Configuración principal de la aplicación Finca
#El archivo .conf.example es un ejemplo de configuración para la aplicación Finca.
#Para usarlo, se debe copiar el archivo a .conf y modificar los valores de acuerdo a la configuración de la base de datos, ChirpStack, etc. 


# Configuración de la Base de Datos PostgreSQL
[database]
host = localhost
port = 5432
database = database_name
username = database_username
password = database_password
schema = public
max_connections = 100
idle_timeout = 10000

# Configuración de ChirpStack
[chirpstack]
api_url = http://server_api_chirpstack:8090
api_token = your_chirpstack_api_token
tenant_id = your_chirpstack_tenant_id
application_id = your_chirpstack_application_id

# Configuración específica para dispositivos LoRaWAN
[chirpstack.device_profiles]
cattle_profile_id = your_chirpstack_cattle_profile_id
climate_profile_id = your_chirpstack_climate_profile_id
cattle_join_eui = app_key_of_device
nwk_key = your_network_key  # 32 caracteres hexadecimales, Es la clave que usamos para la seguridad de la red
app_key = your_app_key      # 32 caracteres hexadecimales