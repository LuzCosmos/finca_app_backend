# Entorno de desarrollo(develop), entorno de pruebas (testing) o producción (production)
ENVIRONMENT=develop
#path where ENVIRONMENT folder structure will be created. See README.md file
BASE_PATH=/srv

# Puerto de la aplicación
APP_PORT=3000

# Configuración de la Base de Datos PostgreSQL
FA_DB_HOST=127.0.0.1
FA_DB_PORT=5432
FA_DB_NAME=database_name
FA_DB_USER=database_username
FA_DB_PASSWORD=database_password
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=10000

# Configuración de ChirpStack
CHIRPSTACK_API_URL=http://server_api_chirpstack:8090
CHIRPSTACK_API_KEY=your_chirpstack_api_token
CHIRPSTACK_TENANT_ID=your_chirpstack_tenant_id

# Configuración de JWT
#node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_clave_secreta_muy_segura_aqui
JWT_EXPIRATION=24h 
JWT_TTL= 86400 # is the JWT_EXPIRATION in seconds

# Configuración de Redis
FA_REDIS_HOST=127.0.0.1
FA_REDIS_PORT=6378
#node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FA_REDIS_PASSWORD=your_redis_password

MQTT_BROKER_URL=mqtt://192.168.80.27:31883

#chirpstack mosquitto
MQTT_BROKER_HOST=server_chirpstack
MQTT_BROKER_PORT=21883
MQTT_BROKER_PROTOCOL=mqtt