# Entorno de desarrollo(development) o producción (production)    
NODE_ENV=production
ENVIRONMENT=production

# Configuración de la Base de Datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=database_name
DB_USER=database_username
DB_PASSWORD=database_password
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=10000

# Configuración de ChirpStack
CHIRPSTACK_API_URL=http://server_api_chirpstack:8090
CHIRPSTACK_API_TOKEN=your_chirpstack_api_token
CHIRPSTACK_TENANT_ID=your_chirpstack_tenant_id

# Puerto de la aplicación
PORT=3000

# Configuración de JWT
JWT_SECRET=tu_clave_secreta_muy_segura_aqui
JWT_EXPIRATION=24h 
JWT_TTL= 86400 # is the JWT_EXPIRATION in seconds

# Configuración de Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
REDIS_PASSWORD=your_redis_password