ENVIRONMENT=develop
SCALE_HOST=127.0.0.1
SCALE_PORT=10001
SCALE_CONNECT_TIMEOUT_MS=5000
SCALE_RECONNECT_BASE_MS=1000
SCALE_RECONNECT_MAX_MS=30000

SCALE_READING_TOLERANCE_PERCENT=0.5
SCALE_STABLE_CONSECUTIVE_READINGS=3
SCALE_ZERO_THRESHOLD_KG=0.1

# Desde el host: localhost. Desde docker compose: host.docker.internal (ver docker-compose.yaml)
# Puerto = APP_PORT_EXTERNAL del backend (en este repo suele ser 23000, no 3000)
BACKEND_BASE_URL=http://host.docker.internal:23000/api/v1
# Debe coincidir con SCALE_BRIDGE_AUTH_TOKEN en finca_app_backend/.env
BRIDGE_AUTH_TOKEN=change-me-scale-bridge-token
BRIDGE_DEVICE_ID=default-scale

LOG_LEVEL=info
